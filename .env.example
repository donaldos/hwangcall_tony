# 복사해서 .env로 쓰세요. 키는 절대 커밋하지 않습니다.

# STT 엔진: openai | fake
STT_ENGINE=openai
# LLM: openai | fake
LLM_PROVIDER=openai
# [중단] 후 자동으로 AI 의견 요청
AUTO_ADVISE=true

# OpenAI LLM — 빠른 응답이 필요하면 gpt-6.1-terra
OPENAI_LLM_MODEL=gpt-6.2-sol

OPENAI_API_KEY=

# OpenAI Realtime 전사
OPENAI_STT_MODEL=gpt-live-transcribe
OPENAI_STT_LANGUAGE=ko
# 인식 힌트(선택). 예: 타로 전화상담 통화. 한국어.
OPENAI_STT_PROMPT=
# 지연/정확도 균형(선택): minimal | low | medium | high | xhigh
OPENAI_STT_DELAY=

# 발화 구간 분할(클라이언트 측 VAD) — 스피커폰 실측으로 조정
STT_VAD_THRESHOLD_DBFS=-45
STT_VAD_SILENCE_MS=600
STT_MAX_SEGMENT_MS=15000
STT_FINALIZE_TIMEOUT_MS=8000

# 브라우저 마이크 처리
MIC_ECHO_CANCELLATION=false
MIC_NOISE_SUPPRESSION=false
MIC_AUTO_GAIN_CONTROL=true
